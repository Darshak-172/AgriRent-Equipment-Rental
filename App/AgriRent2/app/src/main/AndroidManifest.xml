<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Agrirent">

        <!-- FCM default notification icon and color -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_foreground" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/agri_green" />

        <activity android:name=".activities.HomeActivity" />
        <activity android:name=".activities.MainActivity" />

        <activity android:name=".activities.CartActivity" />
        <activity android:name=".activities.OrderSuccessActivity" />
        <activity android:name=".activities.CreateComplaintActivity" />
        <activity android:name=".activities.ComplaintListActivity" />
        <activity android:name=".activities.MyReviewsActivity" />
        <activity android:name=".activities.IncomingComplaintsActivity" />
        <activity android:name=".activities.IncomingReviewsActivity" />

        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".activities.LanguageActivity" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.ChangePasswordActivity"
            android:exported="false" />

        <activity
            android:name=".activities.SettingsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.DashboardActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.NotificationsActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.ManageEquipmentActivity"
            android:screenOrientation="portrait" />
            
        <activity
            android:name=".activities.AddEquipmentActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.EditEquipmentActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.AddProductActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.EditProductActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.ManageProductActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.AddListingActivity"
            android:theme="@style/Theme.Agrirent.FullScreen"
            android:screenOrientation="portrait" />
                        
        <activity
            android:name=".activities.SubscriptionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.EquipmentDetailActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AllEquipmentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.AllProductsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.ProductDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
            
        <activity
            android:name=".activities.PlaceOrderActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
            
        <activity
            android:name=".activities.OrdersActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
            
        <activity
            android:name=".activities.OrderDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity 
            android:name=".activities.BookingsActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity
            android:name=".activities.ScheduleBookingActivity"
            android:exported="false" />

        <activity
            android:name=".activities.BookingDetailActivity"
            android:exported="false" />

        <activity
            android:name=".activities.MySubscriptionsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.PaymentHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".activities.WeatherActivity"
            android:exported="false" />

        <activity
            android:name=".activities.SearchResultsActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".services.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>