<?xml version="1.0" encoding="utf-8"?>
<!--
  THE MAIN SUBSCRIPTION SCREEN
  Design: Deep dark forest green full-screen background,
  white "sheet" scrolls up from bottom with plan cards.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_subscription_dark">

    <!-- ═══════════════════════════════════════
         TOP DARK SECTION  (logo, title, tagline)
         ═══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/llTopSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Row: Back + My Subs link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFF"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/tvMySubscriptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Plans →"
                android:textColor="#AAFFCC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Crown icon + title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="👑"
            android:textSize="40sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="AgriRent Premium"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Unlock equipment listing &amp; product selling"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════
         WHITE SHEET (slides up over dark bg)
         ═══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/llSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="230dp"
        android:background="#F2F7F2"
        android:paddingTop="28dp">

        <!-- Drag handle pill -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="#CCCCCC"
            />

        <!-- ── LOADING ──────────────────────── -->
        <LinearLayout
            android:id="@+id/llLoading"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:indeterminateTint="#2E7D32" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finding the best plans for you…"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginTop="14dp" />

        </LinearLayout>

        <!-- ── ERROR ────────────────────────── -->
        <LinearLayout
            android:id="@+id/llError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="52sp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Couldn't load plans. Check your connection."
                android:textColor="#777777"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:text="Try Again"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/agri_green" />

        </LinearLayout>

        <!-- ── EMPTY ─────────────────────────── -->
        <LinearLayout
            android:id="@+id/llEmpty"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌾"
                android:textSize="60sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No plans available right now"
                android:textColor="#AAAAAA"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- ── PLAN CARDS ────────────────────── -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llPlans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone" />

                <!-- Lock icon footer -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="🔒  Secure payments via Razorpay"
                    android:textColor="#BBBBBB"
                    android:textSize="12sp"
                    android:paddingTop="24dp"
                    android:paddingBottom="40dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</FrameLayout>
