<?xml version="1.0" encoding="utf-8"?>
<!--
  Subscription history item card — shown inside My Subscriptions list
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/subCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Plan name + status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Left: plan name -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSubPlanName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Starter Plan"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A2E1A" />

                <TextView
                    android:id="@+id/tvSubId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#3"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Status badge -->
            <TextView
                android:id="@+id/tvSubStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Active"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:background="@drawable/bg_price_tag"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginBottom="16dp" />

        <!-- Started row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="16sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Started"
                android:textSize="13sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvSubStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18 Feb 2026"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A2E1A" />

        </LinearLayout>

        <!-- Expires row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰"
                android:textSize="16sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Expires"
                android:textSize="13sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvSubEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18 Jul 2026"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
