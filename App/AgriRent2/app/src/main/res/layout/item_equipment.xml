<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="340dp"
    android:layout_marginEnd="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Equipment Image Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <!-- Equipment Image -->
            <ImageView
                android:id="@+id/ivEquipmentImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Equipment Image" />

            <!-- Gradient Overlay for better text readability -->
            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_overlay" />

        </FrameLayout>

        <!-- Equipment Info Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

            <!-- Equipment Name -->
            <TextView
                android:id="@+id/tvEquipmentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipment Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:ellipsize="end"
                android:maxLines="2"
                android:layout_marginBottom="4dp" />

            <!-- Category Badge -->
            <TextView
                android:id="@+id/tvEquipmentCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/category_badge_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="8dp" />

            <!-- Location & Owner Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvEquipmentLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 Location"
                    android:textSize="12sp"
                    android:textColor="#7F8C8D"
                    android:ellipsize="end"
                    android:maxLines="1" />

            </LinearLayout>

            <!-- Price & Action Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEquipmentPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹1500/day"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/agri_green" />

                    <TextView
                        android:id="@+id/tvEquipmentOwner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="By Owner"
                        android:textSize="10sp"
                        android:textColor="#95A5A6"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- Rent Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRent"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Rent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/agri_green"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
