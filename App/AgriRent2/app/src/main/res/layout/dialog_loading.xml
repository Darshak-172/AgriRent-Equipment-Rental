<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000">

    <!-- Semi-transparent background -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- Center loading content -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <!-- Outer rotating ring 2 (larger, slower, counter-clockwise) -->
        <View
            android:id="@+id/outerRotatingRing2"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:background="@drawable/rotating_ring_2" />

        <!-- Outer rotating ring 1 (smaller, faster, clockwise) -->
        <View
            android:id="@+id/outerRotatingRing1"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:background="@drawable/rotating_ring_1" />

        <!-- White circle background (bigger) -->
        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/white_circle_bg" />

        <!-- Content inside white circle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Logo image (bigger and visible) -->
            <ImageView
                android:id="@+id/imgLoadingLogo"
                android:layout_width="162dp"
                android:layout_height="148dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />

            <!-- Loading text below logo -->

            <!-- Please wait text with animated dots -->
            <TextView
                android:id="@+id/tvLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Loading"
                android:textColor="@color/agri_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Please wait"
                    android:textSize="12sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/tvLoadingDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginStart="2dp"
                    android:minWidth="16dp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
