<?xml version="1.0" encoding="utf-8"?>
<!--
  Premium plan card — used for both normal (white) and popular (dark gradient).
  Colors are switched programmatically by SubscriptionActivity.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/planCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Top row: Plan name + BEST VALUE badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvPlanName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Starter Plan"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#1A2E1A" />

            <TextView
                android:id="@+id/tvBestBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEST VALUE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:background="@drawable/bg_price_tag"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Duration pill -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30 days"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="18dp" />

        <!-- ── Feature rows ─────────────────────── -->

        <!-- Equipment row -->
        <LinearLayout
            android:id="@+id/rowEquipment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <!-- Icon circle -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_success_circle"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🚜"
                    android:textSize="16sp" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEquipmentFeature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="List up to 5 equipment"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A2E1A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Owner role assigned automatically"
                    android:textSize="11sp"
                    android:textColor="#888888" />

            </LinearLayout>

        </LinearLayout>

        <!-- Products row -->
        <LinearLayout
            android:id="@+id/rowProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_success_circle"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🌱"
                    android:textSize="16sp" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProductsFeature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sell up to 5 products"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A2E1A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seller role assigned automatically"
                    android:textSize="11sp"
                    android:textColor="#888888" />

            </LinearLayout>

        </LinearLayout>

        <!-- Farmer row (always visible) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_success_circle"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🧑‍🌾"
                    android:textSize="16sp" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Farmer role retained"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A2E1A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your existing role is never removed"
                    android:textSize="11sp"
                    android:textColor="#888888" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="18dp" />

        <!-- Price + CTA row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Price column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹100"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20" />

                <TextView
                    android:id="@+id/tvPriceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="one-time for 30 days"
                    android:textSize="11sp"
                    android:textColor="#AAAAAA" />

            </LinearLayout>

            <!-- Subscribe button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubscribe"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:text="Subscribe"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                app:cornerRadius="27dp"
                app:backgroundTint="@color/agri_green" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
