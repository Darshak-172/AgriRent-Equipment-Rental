<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Dramatic Curved Header Background -->
            <View
                android:id="@+id/headerBg"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="@drawable/bg_dashboard_header_organic"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Back Arrow -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF"
                android:padding="8dp"
                android:background="@drawable/bg_circle_dark_translucent"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:clickable="true"
                android:focusable="true" />

            <!-- User Avatar & Title -->
            <LinearLayout
                android:id="@+id/llProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBack">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/user_placeholder"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleStyle"
                    app:strokeColor="#80FFFFFF"
                    app:strokeWidth="2dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello, Farmer!"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:letterSpacing="-0.02"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Premium Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_pill_golden"
                        android:paddingStart="8dp" android:paddingEnd="10dp"
                        android:paddingTop="2dp" android:paddingBottom="2dp">
                        
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_star"
                            app:tint="#FFD700"
                            android:layout_marginEnd="4dp"/>
                            
                        <TextView
                            android:id="@+id/tvUserSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Premium Partner"
                            android:textColor="#FFD700"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnLogout"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="11dp"
                    android:src="@drawable/ic_logout"
                    app:tint="#FF5252"
                    android:background="@drawable/bg_circle_translucent"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Revenue Analytics Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRevenueAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="28dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/llProfile">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvAnalyticsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Earnings"
                                android:textColor="#757575"
                                android:textSize="12sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvEarningsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0"
                                android:textColor="#212121"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvGrowthPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0% this week"
                            android:textColor="#0df26c"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_pill_green_translucent"
                            android:paddingStart="8dp" android:paddingEnd="8dp"
                            android:paddingTop="4dp" android:paddingBottom="4dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvInsightSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Trust 82/100 • Bookings 64% • Orders 71% • Canceled 1"
                        android:textColor="#757575"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Series Filters -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none">
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cgSeries"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipAll"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total"
                                android:textColor="@color/text_chip_state"
                                app:chipBackgroundColor="@color/bg_chip_state"
                                app:chipStrokeWidth="0dp"
                                android:checked="true" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipEquip"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Equip"
                                android:textColor="@color/text_chip_state"
                                app:chipBackgroundColor="@color/bg_chip_state"
                                app:chipStrokeWidth="0dp" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipProd"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Prod"
                                android:textColor="@color/text_chip_state"
                                app:chipBackgroundColor="@color/bg_chip_state"
                                app:chipStrokeWidth="0dp" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSpend"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Spend"
                                android:textColor="@color/text_chip_state"
                                app:chipBackgroundColor="@color/bg_chip_state"
                                app:chipStrokeWidth="0dp" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Time Filters -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipWeek"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Week"
                            android:textSize="11sp"
                            android:textColor="@color/text_chip_state"
                            app:chipBackgroundColor="@color/bg_chip_state"
                            app:chipStrokeWidth="0dp"
                            android:checked="true" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMonth"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Month"
                            android:textSize="11sp"
                            android:textColor="@color/text_chip_state"
                            app:chipBackgroundColor="@color/bg_chip_state"
                            app:chipStrokeWidth="0dp" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipYear"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Year"
                            android:textSize="11sp"
                            android:textColor="@color/text_chip_state"
                            app:chipBackgroundColor="@color/bg_chip_state"
                            app:chipStrokeWidth="0dp" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Custom Sparkline Chart -->
                    <com.example.agrirent.views.SparklineView
                        android:id="@+id/sparklineRevenue"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mon" android:textColor="#9E9E9E" android:textSize="10sp" android:gravity="center" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tue" android:textColor="#9E9E9E" android:textSize="10sp" android:gravity="center" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Wed" android:textColor="#9E9E9E" android:textSize="10sp" android:gravity="center" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thu" android:textColor="#9E9E9E" android:textSize="10sp" android:gravity="center" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fri" android:textColor="#9E9E9E" android:textSize="10sp" android:gravity="center" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sat" android:textColor="#9E9E9E" android:textSize="10sp" android:gravity="center" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sun" android:textColor="#212121" android:textSize="10sp" android:gravity="center" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secondary Stats Grid (Smaller) -->
            <LinearLayout
                android:id="@+id/llSecondaryStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/cardRevenueAnalytics">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:id="@+id/tvBookingsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24"
                            android:textColor="#212121"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bookings"
                            android:textColor="#757575"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:layout_marginStart="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:id="@+id/tvOrdersCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12"
                            android:textColor="#212121"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prod Orders"
                            android:textColor="#757575"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Trust & Safety Section -->
            <TextView
                android:id="@+id/tvTrustLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trust &amp; Support"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"
                app:layout_constraintTop_toBottomOf="@id/llSecondaryStats"
                app:layout_constraintStart_toStartOf="parent"/>

            <LinearLayout
                android:id="@+id/llTrustGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvTrustLabel">

                <!-- KYC Status -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVerifyKYC"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#A5D6A7"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_verified"
                            app:tint="#0df26c" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subscription Status"
                            android:textColor="#212121"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Complaints / Help (Changed to My Complaints) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardComplaints"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:layout_marginStart="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_complaint" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Complaints"
                            android:textColor="#212121"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTrustGridRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/llTrustGrid">

                <!-- My Reviews -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMyReviews"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_star"
                            app:tint="#F57F17" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Reviews"
                            android:textColor="#212121"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- placeholder or future item -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Received History Section (Sellers/Owners only) -->
            <TextView
                android:id="@+id/tvReceivedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Received Feedbacks"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"
                app:layout_constraintTop_toBottomOf="@id/llTrustGridRow2"
                app:layout_constraintStart_toStartOf="parent"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/llReceivedGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvReceivedLabel"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReceivedComplaints"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_complaint"
                            app:tint="#D32F2F" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Received Complaints"
                            android:textColor="#212121"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReceivedReviews"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#C8E6C9"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:layout_marginStart="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_star"
                            app:tint="#2E7D32" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Received Reviews"
                            android:textColor="#212121"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/tvCommandLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Business Command Center"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"
                app:layout_constraintTop_toBottomOf="@id/llReceivedGrid"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Combined Management Center -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMasterManagement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="28dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvCommandLabel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Fleet Management Row -->
                    <LinearLayout
                        android:id="@+id/cardManageEquipment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle_neon_green_translucent"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_equipment"
                                app:tint="#0df26c" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Equipment"
                                android:textColor="#212121"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Audit your tractors &amp; tools"
                                android:textColor="#757575"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/ivEquipArrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="#0df26c" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginStart="84dp" />

                    <!-- Inventory Hub Row -->
                    <LinearLayout
                        android:id="@+id/cardManageProducts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle_neon_green_translucent"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_products"
                                app:tint="#0df26c" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Products"
                                android:textColor="#212121"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stock control &amp; orders"
                                android:textColor="#757575"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/ivProdArrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="#0df26c" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginStart="84dp" />

                    <!-- Maintenance Log Row -->

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:layout_constraintTop_toBottomOf="@id/cardMasterManagement"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
