<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Scrollable body -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Hero Image Carousel -->
            <RelativeLayout
                android:id="@+id/heroArea"
                android:layout_width="match_parent"
                android:layout_height="400dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpEquipmentImages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Gradient overlay at the bottom to blend image -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/bg_image_fade" />
                    
                <!-- Dots Indicator for Slider -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayoutIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="124dp"
                    android:background="@android:color/transparent"
                    app:tabBackground="@drawable/tab_selector_dot"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabMaxWidth="12dp" />

            </RelativeLayout>

            <!-- Main Interactive Content overlapping hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/heroArea"
                android:layout_marginTop="-110dp"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- 1. The Glass Box (Title & Specs) -->
                <LinearLayout
                    android:id="@+id/cardDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_glass_card"
                    android:elevation="0dp"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvEquipmentName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="John Deere 8R 370"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@id/tvAvailablePill"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tvAvailablePill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_available_pill"
                            android:paddingStart="10dp" android:paddingEnd="10dp"
                            android:paddingTop="4dp" android:paddingBottom="4dp"
                            android:text="AVAILABLE"
                            android:textColor="#2E7D32"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Category & Subcategory Badges -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <!-- Category Pill -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_available_pill"
                            android:backgroundTint="#F3F4F6"
                            android:paddingStart="10dp" android:paddingEnd="10dp"
                            android:paddingTop="6dp" android:paddingBottom="6dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:id="@+id/tvEquipmentCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Category"
                                android:textColor="#4B5563"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- SubCategory Pill -->
                        <LinearLayout
                            android:id="@+id/llSubCategoryPillContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_available_pill"
                            android:backgroundTint="#EFF6FF"
                            android:paddingStart="10dp" android:paddingEnd="10dp"
                            android:paddingTop="6dp" android:paddingBottom="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvEquipmentSubCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SubCategory"
                                android:textColor="#1D4ED8"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- 2. Owner Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#1A888888"
                    app:cardBackgroundColor="@android:color/transparent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvOwnerAvatar"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_circle_translucent"
                            android:gravity="center"
                            android:textColor="@color/agri_dark_green"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:text="A" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/tvOwnerAvatar"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvOwnerName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AgriCo Rentals"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Verified Owner"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- WhatsApp Button and Rating Badge container -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            
                            <!-- WhatsApp Button -->
                            <ImageButton
                                android:id="@+id/btnOwnerWhatsApp"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_circle_white"
                                android:elevation="2dp"
                                android:padding="8dp"
                                android:src="@drawable/ic_whatsapp"
                                app:tint="#25D366" />
        
                            <!-- Rating Badge -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_available_pill"
                                android:backgroundTint="#FFF8E1"
                                android:orientation="horizontal"
                                android:paddingStart="8dp" android:paddingEnd="8dp"
                                android:paddingTop="4dp" android:paddingBottom="4dp">
                                <TextView
                                    android:id="@+id/tvAverageRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="★ 0.0 "
                                    android:textColor="#F57F17"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvReviewCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="(0)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Tabs -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayoutSections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/transparent"
                    app:tabIndicatorColor="#2E7D32"
                    app:tabSelectedTextColor="#2E7D32"
                    app:tabTextColor="@color/text_secondary"
                    app:tabIndicatorHeight="2dp"
                    app:tabTextAppearance="@style/TextAppearance.AppCompat.Small"
                    app:tabMode="fixed">
                    <com.google.android.material.tabs.TabItem android:text="Overview" />
                    <com.google.android.material.tabs.TabItem android:text="Reviews" />
                    <com.google.android.material.tabs.TabItem android:text="Location" />
                </com.google.android.material.tabs.TabLayout>

                <!-- Thin full-width divider under tabs -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1A888888"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>

                <!-- 4. Content Area -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="20dp">

                    <!-- Overview Content -->
                    <LinearLayout
                        android:id="@+id/llOverviewContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEquipmentDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="The John Deere 8R 370 is designed for high-performance agriculture..."
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"/>
                    </LinearLayout>

                    <!-- Reviews Content (Hidden by default) -->
                    <LinearLayout
                        android:id="@+id/llReviewsContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Review Submission Form -->
                        <LinearLayout
                            android:id="@+id/llReviewForm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_glass_card"
                            android:padding="16dp"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Write a Review"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_marginBottom="8dp"/>

                            <!-- Note: Using standard RatingBar due to missing custom lib -->
                            <RatingBar
                                android:id="@+id/ratingBarInput"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:numStars="5"
                                android:stepSize="1"
                                android:rating="5"
                                style="?android:attr/ratingBarStyleIndicator"
                                android:isIndicator="false"
                                android:progressTint="#F57F17"/>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:hintEnabled="false"
                                android:layout_marginTop="8dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etReviewComment"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Share your experience (optional)"
                                    android:background="@drawable/bg_edit_text"
                                    android:padding="12dp"
                                    android:minLines="3"
                                    android:gravity="top"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSubmitReview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Submit"
                                app:cornerRadius="8dp"
                                android:layout_marginTop="12dp"
                                android:layout_gravity="end"/>
                        </LinearLayout>

                        <!-- RecyclerView for listing ratings -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvReviews"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/tvNoReviews"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No reviews yet."
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:layout_marginTop="24dp"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- Location Content (Hidden by default) -->
                    <LinearLayout
                        android:id="@+id/llLocationContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                        
                        <!-- Location Map -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cvViewOnMap"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            android:clickable="true"
                            android:focusable="true">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#D1B88B">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:background="@drawable/bg_available_pill"
                                    android:backgroundTint="@color/card_bg"
                                    android:paddingStart="16dp" android:paddingEnd="16dp"
                                    android:paddingTop="8dp" android:paddingBottom="8dp"
                                    android:text="🗺️ View on Map"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Location Basic Address -->
                        <TextView
                            android:id="@+id/tvEquipmentLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="📍 Des Moines, Iowa (Approx. 5 miles away)"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:gravity="center_vertical"/>
                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Top Action Bar (Floating Icons) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_translucent"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary"
            android:layout_alignParentStart="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_circle_translucent"
                android:src="@drawable/ic_heart_outline"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_translucent"
                android:src="@drawable/ic_share"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom Fix Bar (Price & Book) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/card_bg"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price breakdown"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">
                
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHourlyPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹150/hr"
                        android:textColor="#2E7D32"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDailyPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹800/day"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Book Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookEquipment"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="160dp"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:text="Book Dates"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="#00C853"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</RelativeLayout>
