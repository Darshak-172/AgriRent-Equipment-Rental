<?xml version="1.0" encoding="utf-8"?>
<!--
  Individual payment/transaction card for the history list.
  Shows: plan name, payment ID, amount, date, status badge, Download Receipt button.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/paymentCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── Top row: plan name + status badge ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <!-- Left icon circle -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_success_circle"
                android:layout_marginEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="💳"
                    android:textSize="20sp" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPayPlanName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Starter Plan"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A2E1A" />

                <TextView
                    android:id="@+id/tvPayDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="19 Feb 2026"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Status badge -->

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginBottom="14dp" />

        <!-- Amount row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Amount Paid"
                android:textSize="13sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvPayAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹999"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

        </LinearLayout>

        <!-- Payment ID row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Payment ID"
                android:textSize="13sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvPayId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="pay_xxxxx"
                android:textSize="12sp"
                android:textColor="#555555"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginBottom="14dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- View Receipt button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewReceipt"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="👁️ View"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/agri_green"
                android:layout_marginEnd="6dp"
                app:cornerRadius="24dp"
                app:strokeColor="@color/agri_green"
                app:strokeWidth="1.5dp" />

            <!-- Download Receipt button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadReceipt"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="⬇ Download"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/agri_green" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
