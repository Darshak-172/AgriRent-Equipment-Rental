<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AgriRent" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
    </style>

    <style name="Theme.Agrirent" parent="Base.Theme.AgriRent">
        <item name="colorPrimary">@color/agri_dark_green</item>
        <item name="colorPrimaryVariant">@color/agri_dark_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowBackground">#121212</item>
    </style>

    <style name="Theme.Agrirent.FullScreen" parent="Theme.Agrirent">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>