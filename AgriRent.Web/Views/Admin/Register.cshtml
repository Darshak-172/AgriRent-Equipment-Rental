@model AgriRent.DTOs.CreateAdminDto

@{
    ViewData["Title"] = "Admin Registration";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin Registration</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="~/css/agri-admin.css" rel="stylesheet" />
</head>
<body>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-success text-white text-center py-3">
                    <h3>
                        <i class="fa-solid fa-user-shield"></i>
                        Admin Access
                    </h3>
                    <small>Secure Registration Portal</small>
                </div>

                <div class="card-body p-4" style="background-color:#f9fdf9;">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="Register" asp-controller="Admin" method="post">

                        <!-- Username -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Username</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="fa-solid fa-user"></i>
                                </span>
                                <input asp-for="Username"
                                       class="form-control"
                                       placeholder="Enter admin username"
                                       required />
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Create strong password"
                                       required />
                            </div>
                        </div>

                        <!-- Secret Key -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-danger">
                                Secret Key
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-danger text-white">
                                    <i class="fa-solid fa-key"></i>
                                </span>
                                <input asp-for="SecretKey"
                                       type="password"
                                       class="form-control border-danger"
                                       placeholder="Enter Master Key"
                                       required />
                            </div>
                            <small class="text-muted">
                                Required for security verification.
                            </small>
                        </div>

                        <!-- Submit -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fa-solid fa-check-circle"></i>
                                Register Admin
                            </button>
                        </div>

                    </form>
                </div>

                <div class="card-footer text-center bg-light">
                    <a asp-controller="Admin"
                       asp-action="Login"
                       class="text-decoration-none text-success">
                        Back to Login
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>

</body>
</html>
