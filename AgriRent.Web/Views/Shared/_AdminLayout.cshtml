@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>AgriRent Admin</title>
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="~/images/agrirent_logo.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/agrirent_logo.png" loading="lazy" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/agrirent_logo.png" loading="lazy" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Font -->
    <!-- FIX: Changed from display=swap (render-blocking) to display=optional (non-blocking) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=optional" rel="stylesheet">

    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <!-- Bootstrap Grid Only -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Dashboard CSS -->
    <link href="~/css/admin-dashboard.css" rel="stylesheet" />
    <link href="~/css/pending-equipments.css" rel="stylesheet" />
    
    @RenderSection("Styles", required: false)
</head>

<body>

<div class="admin-wrapper">

    <!-- SIDEBAR -->
    <partial name="_AdminSidebar" />

    <!-- MAIN -->
    <main class="main-area">

        <!-- TOP BAR -->
        <header class="topbar">
            <div>
                <h2 class="page-title">@(ViewData["Title"] ?? "Dashboard")</h2>
                <p class="welcome-text">Welcome back, Admin</p>
            </div>

            <div class="topbar-actions">
                <i class="fa-regular fa-bell"></i>
            </div>
        </header>

        <!-- PAGE CONTENT -->
        <section class="page-content">
            @RenderBody()
        </section>

    </main>

</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
    
</body>
</html>
