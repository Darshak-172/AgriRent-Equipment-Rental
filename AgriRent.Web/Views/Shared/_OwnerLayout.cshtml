@{
    var ownerName = Context.Session.GetString("DisplayName") ?? "Owner";
    char initial = ownerName.Length > 0 ? char.ToUpper(ownerName[0]) : 'O';
    string firstName = ownerName.Split(' ')[0];

    // Grab counts if they were set by the Dashboard view, otherwise default to 0
    int pendingCount = ViewData["PendingCount"] as int? ?? 0;
    int pendingBookings = ViewData["PendingBookings"] as int? ?? 0;

    // Get current path to highlight active nav
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    bool isDashboard = currentPath.Contains("/dashboard") && !currentPath.Contains("addequipment") && !currentPath.Contains("updateequipment") && !currentPath.Contains("uploadimage");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- FIX: Changed from display=swap (render-blocking) to display=optional (non-blocking) -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=optional" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/owner-dashboard.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="owner-dashboard-root">

    <!-- ══ SHARED SIDEBAR NAVIGATION ══ -->
    <aside class="od-sidebar">
        <div class="od-sidebar-logo">
            <div class="logo-icon-wrap"><i class="fas fa-tractor"></i></div>
            <div class="logo-text-wrap">
                <span class="logo-title">AgriRent</span>
                <span class="logo-sub">Equipment Portal</span>
            </div>
        </div>

        <a href="/Profile" class="od-sidebar-user" style="text-decoration: none; color: inherit; display: flex; transition: all 0.2s;">
            <div class="user-avatar">@initial</div>
            <div class="user-info">
                <div class="user-name">@ownerName</div>
                <div class="user-role">Equipment Owner</div>
            </div>
        </a>

        <nav class="od-nav">
            <div class="nav-label">Main Menu</div>
            <a href="/Owner/Dashboard" class="od-nav-item @(isDashboard ? "active" : "")">
                <i class="fas fa-chart-pie nav-icon"></i> Dashboard
            </a>
            <a href="/Owner/Dashboard" class="od-nav-item" onclick="if(window.switchSection) { switchSection('equipment',this);return false; }">
                <i class="fas fa-tractor nav-icon"></i> My Equipment
                @if (pendingCount > 0) { <span class="nav-badge">@pendingCount</span> }
            </a>
            <a href="/Owner/Dashboard" class="od-nav-item" onclick="if(window.switchSection) { switchSection('bookings',this);return false; }">
                <i class="fas fa-calendar-alt nav-icon"></i> Bookings
                @if (pendingBookings > 0) { <span class="nav-badge text-white" style="background:#ef4444;">@pendingBookings</span> }
            </a>

            <div class="nav-label mt-4">Feedback & Support</div>
            <a href="/Owner/Dashboard" class="od-nav-item" onclick="if(window.switchSection) { switchSection('my-complaints',this);return false; }">
                <i class="fas fa-comment-dots nav-icon"></i> My Complaints
            </a>
            <a href="/Owner/Dashboard" class="od-nav-item" onclick="if(window.switchSection) { switchSection('incoming-complaints',this);return false; }">
                <i class="fas fa-shield-alt nav-icon"></i> Complaint Manager
            </a>
            <a href="/Owner/Dashboard" class="od-nav-item" onclick="if(window.switchSection) { switchSection('my-reviews',this);return false; }">
                <i class="fas fa-star nav-icon"></i> My Reviews
            </a>
            <a href="/Owner/Dashboard" class="od-nav-item" onclick="if(window.switchSection) { switchSection('incoming-reviews',this);return false; }">
                <i class="fas fa-star-half-alt nav-icon"></i> Review Manager
            </a>

            <div class="nav-label mt-4">Manage</div>
            <a href="/Owner/AddEquipment" class="od-nav-item @(currentPath.Contains("addequipment") ? "active" : "")">
                <i class="fas fa-plus-circle nav-icon"></i> Add Equipment
            </a>

            <div class="nav-label mt-4">Account</div>
            <a href="/Profile" class="od-nav-item @(currentPath == "/profile" ? "active" : "")">
                <i class="far fa-user-circle nav-icon"></i> My Profile
            </a>
            <a href="/Subscription" class="od-nav-item">
                <i class="fas fa-crown nav-icon"></i> Subscription
            </a>
            <a href="/" class="od-nav-item">
                <i class="fas fa-home nav-icon"></i> Back to Home
            </a>
            <a href="/Account/Logout" class="od-nav-item text-danger mt-2">
                <i class="fas fa-sign-out-alt nav-icon"></i> Sign Out
            </a>
        </nav>
    </aside>

    <!-- ══ MAIN DASHBOARD CONTENT ══ -->
    <main class="od-main">
        <div class="od-content-wrapper">
            @RenderBody()
        </div>
    </main>

</div>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
