@model AgriRent.ViewModels.OwnerDashboardViewModel
@{
    Layout = "_OwnerLayout";
    ViewData["Title"] = "Equipment Owner Dashboard – AgriRent";
    ViewData["PendingCount"] = Model.PendingCount;
    ViewData["PendingBookings"] = Model.PendingBookings;

    var now = DateTime.Now;
    string greeting = now.Hour < 12 ? "Good Morning" : now.Hour < 17 ? "Good Afternoon" : "Good Evening";
    bool hasSub = Model.SubscriptionStatus == "Active";
    string firstName = Model.OwnerName.Split(' ')[0];
}

@section Styles {
    <style>
        .dashboard-canvas {
            animation: fadeIn 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
        }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .asset-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 24px;
            margin-top: 24px;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            position: relative;
            overflow: hidden;
        }
        .metric-card {
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 20px;
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 20px;
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .metric-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.06); }
        .metric-card:hover .metric-blob { opacity: 0.3; }
        .metric-blob {
            position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; border-radius: 50%;
            filter: blur(30px); opacity: 0.15; z-index: 0; transition: opacity 0.3s ease;
        }
        .metric-icon-box {
            width: 60px; height: 60px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
            font-size: 24px; position: relative; z-index: 1; transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .metric-card:hover .metric-icon-box { transform: scale(1.1) rotate(5deg); }
        .metric-content { z-index: 1; }
        .metric-value { font-size: 32px; font-weight: 800; color: #0f172a; line-height: 1.1; margin-bottom: 4px; font-family: 'Outfit', sans-serif; }
        .metric-label { font-size: 14px; color: #64748b; font-weight: 500; letter-spacing: 0.5px; }
        
        /* Buttons & Banners */
        .btn-premium {
            display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white; border-radius: 12px; font-weight: 600; font-size: 14px; border: none; box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3); transition: all 0.3s ease; text-decoration: none;
        }
        .btn-premium:hover { transform: translateY(-2px); box-shadow: 0 12px 25px rgba(16, 185, 129, 0.4); color: white; }

        .premium-banner {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border-radius: 20px; padding: 30px; color: white;
            position: relative; overflow: hidden; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 15px 35px rgba(15, 23, 42, 0.2); margin-bottom: 24px;
        }
        .banner-blob { position: absolute; background: linear-gradient(135deg, #10b981, #3b82f6); width: 300px; height: 300px; border-radius: 50%; filter: blur(60px); opacity: 0.3; right: -50px; top: -100px; }

        /* Card Colors */
        .card-green .metric-icon-box { background: rgba(16, 185, 129, 0.15); color: #10b981; } .card-green .metric-blob { background: #10b981; }
        .card-orange .metric-icon-box { background: rgba(245, 158, 11, 0.15); color: #f59e0b; } .card-orange .metric-blob { background: #f59e0b; }
        .card-blue .metric-icon-box { background: rgba(59, 130, 246, 0.15); color: #3b82f6; } .card-blue .metric-blob { background: #3b82f6; }
        .card-purple .metric-icon-box { background: rgba(139, 92, 246, 0.15); color: #8b5cf6; } .card-purple .metric-blob { background: #8b5cf6; }

        /* P-Grid (Equipment) */
        .p-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
        .p-card { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 16px; padding: 16px; transition: all 0.3s ease; box-shadow: 0 8px 20px rgba(0,0,0,0.03); display: flex; flex-direction: column; }
        .p-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.08); border-color: rgba(16, 185, 129, 0.3); }
        .p-img-wrap { height: 160px; border-radius: 12px; overflow: hidden; position: relative; background: #f8fafc; }
        .p-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .p-card:hover .p-img-wrap img { transform: scale(1.05); }
        .p-status { position: absolute; top: 10px; right: 10px; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; backdrop-filter: blur(4px); text-transform: uppercase; letter-spacing: 0.5px; }
        .p-active { background: rgba(16, 185, 129, 0.9); color: white; } .p-pending { background: rgba(245, 158, 11, 0.9); color: white; } .p-rejected { background: rgba(239, 68, 68, 0.9); color: white; }
        .p-cat { font-size: 12px; color: #10b981; font-weight: 600; text-transform: uppercase; margin-top: 16px; }
        .p-title { font-size: 17px; font-weight: 700; color: #1e293b; margin: 4px 0 8px 0; font-family:'Outfit',sans-serif; }
        .p-price { font-size: 18px; font-weight: 800; color: #0f172a; }
        .p-unit { font-size: 13px; color: #64748b; font-weight: 500; }
        .p-actions { margin-top: 16px; display: flex; gap: 8px; border-top: 1px solid rgba(0,0,0,0.05); padding-top: 16px; }
        .p-btn { flex: 1; padding: 8px 0; border-radius: 8px; border: none; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; justify-content: center; gap: 6px; text-decoration: none; }
        .btn-photo { background: #e0f2fe; color: #0369a1; } .btn-photo:hover { background: #bae6fd; }
        .btn-edit { background: #ecfdf5; color: #047857; } .btn-edit:hover { background: #d1fae5; }
        .btn-del { background: #fee2e2; color: #b91c1c; } .btn-del:hover { background: #fecaca; }

        /* O-Row (Bookings) */
        .o-row { background: rgba(255,255,255,0.7); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.9); border-radius: 16px; padding: 20px; margin-bottom: 16px; display: flex; align-items: center; gap: 20px; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(0,0,0,0.02); }
        .o-row:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.05); border-color: rgba(16, 185, 129, 0.2); }
        .o-avatar { width: 50px; height: 50px; border-radius: 14px; background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #059669; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.15); flex-shrink: 0; }
        .o-details { flex-grow: 1; }
        .o-title { font-size: 16px; font-weight: 700; color: #0f172a; margin: 0 0 4px 0; }
        .o-meta { font-size: 13px; color: #64748b; display: flex; align-items: center; gap: 12px; }
        .o-finance { text-align: right; padding: 0 24px; border-right: 1px solid rgba(0,0,0,0.06); }
        .o-amt { font-size: 18px; font-weight: 800; color: #10b981; }
        .o-actions { min-width: 140px; display: flex; justify-content: flex-end; gap:8px;}
        .btn-o { padding: 8px 16px; border-radius: 10px; border: none; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 6px; }
        .btn-o-proc { background: #fef3c7; color: #d97706; box-shadow: 0 4px 10px rgba(245, 158, 11, 0.15); } .btn-o-proc:hover { background: #fde68a; transform: translateY(-2px); }
        .btn-o-del { background: #dcfce7; color: #16a34a; box-shadow: 0 4px 10px rgba(22, 163, 74, 0.15); } .btn-o-del:hover { background: #bbf7d0; transform: translateY(-2px); }
        .btn-o-rej { background: #fee2e2; color: #ef4444; box-shadow: 0 4px 10px rgba(239, 68, 68, 0.15); padding: 8px 12px;} .btn-o-rej:hover { background: #fecaca; transform: translateY(-2px); }
        .o-pill { padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }

        @@media (max-width: 768px) {
            .o-row { flex-direction: column; text-align: center; gap: 12px; }
            .o-finance { border-right: none; border-bottom: 1px solid rgba(0,0,0,0.06); padding: 12px 0; text-align: center; }
            .premium-banner { flex-direction: column; text-align: center; gap: 20px; }
            .topbar-mobile-hide { display:none; }
        }
    </style>
}

<div class="dashboard-canvas">

    <!-- Native Flexbox Header & Flash Messages -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px; flex-wrap:wrap; gap:16px;">
        <div>
            <h1 class="page-title" style="font-size:26px;font-weight:800;color:#0f172a;margin-bottom:4px;font-family:'Outfit',sans-serif;">
                <i class="fas fa-layer-group" style="color:#10b981;"></i> Dashboard <span style="font-weight:400;color:#94a3b8;">Overview</span>
            </h1>
            <div style="color:#64748b; font-size:14px;font-weight:500;" id="topbarClock">
                <i class="far fa-clock"></i> <span></span>
            </div>
        </div>
        <div>
            <a href="/Owner/AddEquipment" class="btn-premium">
                <i class="fas fa-plus-circle"></i> List New Equipment
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background:#dcfce7; color:#16a34a; padding:16px 20px; border-radius:12px; margin-bottom:24px; font-weight:700; display:flex; align-items:center; gap:8px;">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background:#fee2e2; color:#ef4444; padding:16px 20px; border-radius:12px; margin-bottom:24px; font-weight:700; display:flex; align-items:center; gap:8px;">
            <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }

    <!-- ══ SECTION: OVERVIEW ══════════════════════════════════ -->
    <div id="sec-overview" class="od-section active animate-fade-in">
        
        <div class="mb-4">
            <h2 style="font-size:28px;font-family:'Outfit',sans-serif;font-weight:700;color:#0f172a;">
                Welcome back, @firstName <span style="color:#10b981;">👋</span>
            </h2>
        </div>
        
        <!-- Premium Subscription Banner -->
        <div class="premium-banner">
            <div class="banner-blob"></div>
            <div style="position:relative; z-index:1;">
                <div style="font-size:14px; font-weight:700; color:#cbd5e1; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">
                    Subscription Status
                </div>
                <h3 style="font-size:24px; font-weight:800; margin:0 0 4px 0;">@(hasSub ? "Demo Plan" : "Unlock Your Potential")</h3>
                @if (hasSub && Model.SubscriptionExpiry.HasValue)
                {
                    <div style="font-size:15px; color:#94a3b8;">
                        Active until @Model.SubscriptionExpiry.Value.ToString("MMM dd, yyyy") 
                        (@((Model.SubscriptionExpiry.Value - DateTime.UtcNow).Days) days left)
                    </div>
                }
                else if (!hasSub)
                {
                    <div style="font-size:15px; color:#94a3b8;">Upgrade to Premium to get unlimited machinery slots.</div>
                }
            </div>
            <div style="position:relative; z-index:1;">
                @if (hasSub)
                {
                    <div style="background:rgba(255,255,255,0.1); backdrop-filter:blur(10px); padding:8px 20px; border-radius:20px; font-weight:700; border:1px solid rgba(255,255,255,0.2);">
                        <i class="fas fa-crown text-warning me-2"></i> Active Member
                    </div>
                }
                else
                {
                    <a href="/Subscription" class="btn-premium" style="background:#f59e0b; color:white; border:none; box-shadow:0 8px 20px rgba(245, 158, 11, 0.3);">
                        <i class="fas fa-bolt"></i> Upgrade Now
                    </a>
                }
            </div>
        </div>

        <h3 style="font-size:18px; font-weight:700; color:#1e293b; margin-top:32px; margin-bottom:16px;"><i class="fas fa-chart-pie" style="color:#10b981;"></i> Fleet Metrics</h3>
        
        <!-- Premium Glass Asset Grid -->
        <div class="asset-grid">
            <!-- Equipment -->
            <div class="metric-card card-blue">
                <div class="metric-blob"></div>
                <div class="metric-icon-box"><i class="fas fa-tractor"></i></div>
                <div class="metric-content">
                    <div class="metric-value">@Model.TotalEquipments</div>
                    <div class="metric-label">Total Equipment</div>
                </div>
            </div>
            <div class="metric-card card-green">
                <div class="metric-blob"></div>
                <div class="metric-icon-box"><i class="fas fa-check-circle"></i></div>
                <div class="metric-content">
                    <div class="metric-value">@(Model.TotalEquipments - Model.PendingCount)</div>
                    <div class="metric-label">Live Listings</div>
                </div>
            </div>
            <div class="metric-card card-orange">
                <div class="metric-blob"></div>
                <div class="metric-icon-box"><i class="fas fa-clock"></i></div>
                <div class="metric-content">
                    <div class="metric-value">@Model.PendingCount</div>
                    <div class="metric-label">Pending Approval</div>
                </div>
            </div>

            <!-- Bookings -->
            <div class="metric-card card-purple">
                <div class="metric-blob"></div>
                <div class="metric-icon-box"><i class="fas fa-calendar-alt"></i></div>
                <div class="metric-content">
                    <div class="metric-value">@Model.TotalBookings</div>
                    <div class="metric-label">Total Bookings</div>
                </div>
            </div>
            <div class="metric-card card-orange">
                <div class="metric-blob"></div>
                <div class="metric-icon-box"><i class="fas fa-inbox"></i></div>
                <div class="metric-content">
                    <div class="metric-value">@Model.PendingBookings</div>
                    <div class="metric-label">Awaiting Process</div>
                </div>
            </div>
            <div class="metric-card card-green" style="border: 2px solid rgba(16, 185, 129, 0.4);">
                <div class="metric-blob" style="opacity:0.25;"></div>
                <div class="metric-icon-box" style="background:#10b981; color:white;"><i class="fas fa-wallet"></i></div>
                <div class="metric-content">
                    <div class="metric-value" style="color:#10b981;">₹@Model.TotalEarnings.ToString("N0")</div>
                    <div class="metric-label">Total Earnings</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ SECTION: MY EQUIPMENT ══════════════════════════════ -->
    <div id="sec-equipment" class="od-section" style="display:none; margin-top:24px;">
        @if (!Model.Equipments.Any())
        {
            <div class="glass-panel text-center py-5">
                <div class="text-muted" style="font-size:48px; opacity:0.3; margin-bottom:16px;"><i class="fas fa-seedling"></i></div>
                <h3 style="font-weight:700; color:#0f172a;">Your fleet is empty</h3>
                <p style="color:#64748b;">Start listing your agricultural equipment to help farmers and increase your earnings today.</p>
                <a href="/Owner/AddEquipment" class="btn-premium mt-3">List First Item</a>
            </div>
        }
        else
        {
            <div class="p-grid">
                @foreach (var eq in Model.Equipments)
                {
                    <div class="p-card">
                        <div class="p-img-wrap">
                            <img src="@(string.IsNullOrEmpty(eq.ImageUrl) ? "/images/default-image.svg" : eq.ImageUrl)"
                                 alt="@eq.EquipmentName" onerror="this.onerror=null;this.src='/images/default-image.svg'" />
                            <div class="p-status p-@(eq.Status.ToLower())">@eq.Status</div>
                        </div>
                        <div class="p-info" style="flex-grow:1;">
                            <div class="p-cat">@(string.IsNullOrEmpty(eq.CategoryName) ? "General" : eq.CategoryName)</div>
                            <h4 class="p-title">@eq.EquipmentName</h4>
                            <div class="p-price">₹@eq.Price <span class="p-unit">/@eq.PriceType</span></div>
                            <div style="font-size:13px; color:#64748b; margin-top:8px;">
                                <i class="fas fa-map-marker-alt" style="color:#e2e8f0;"></i> <strong>@eq.Location</strong>
                            </div>
                        </div>
                        <div class="p-actions">
                            <a href="/Owner/UploadImage?equipmentId=@eq.EquipmentId" class="p-btn btn-photo" title="Photos"><i class="fas fa-camera"></i></a>
                            <a href="/Owner/UpdateEquipment/@eq.EquipmentId" class="p-btn btn-edit" title="Edit"><i class="fas fa-pen"></i></a>
                            @if (eq.Status == "Active" || eq.Status == "Blocked")
                            {
                                <button class="p-btn @(eq.Status == "Active" ? "btn-warning" : "btn-success")" 
                                        onclick="document.getElementById('toggleForm_@eq.EquipmentId').submit()" 
                                        title="@(eq.Status == "Active" ? "Block" : "Unblock")"
                                        style="background: @(eq.Status == "Active" ? "#fef3c7" : "#d1fae5"); color: @(eq.Status == "Active" ? "#d97706" : "#059669");">
                                    <i class="fas @(eq.Status == "Active" ? "fa-ban" : "fa-check-circle")"></i>
                                </button>
                                <form id="toggleForm_@eq.EquipmentId" action="/Owner/ToggleEquipmentStatus/@eq.EquipmentId" method="post" style="display:none;">
                                    @Html.AntiForgeryToken()
                                </form>
                            }
                            <button type="button" class="p-btn btn-del" data-id="@eq.EquipmentId" data-name="@eq.EquipmentName" onclick="confirmDelete(this)" title="Delete"><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ══ SECTION: BOOKINGS ══════════════════════════════════ -->
    <div id="sec-bookings" class="od-section" style="display:none; margin-top:24px;">
        @if (!Model.Bookings.Any())
        {
            <div class="glass-panel text-center py-5">
                <div class="text-muted" style="font-size:48px; opacity:0.3; margin-bottom:16px;"><i class="far fa-calendar-times"></i></div>
                <h3 style="font-weight:700; color:#0f172a;">No Bookings Yet</h3>
                <p style="color:#64748b;">When farmers book your listed equipment, their requests will appear here for you to manage.</p>
            </div>
        }
        else
        {
            <div class="o-list">
                @foreach (var b in Model.Bookings)
                {
                    <div class="o-row" style="margin-bottom:12px;">
                        <div class="o-avatar">@(b.FarmerName.Length > 0 ? char.ToUpper(b.FarmerName[0]) : 'F')</div>
                        
                        <div class="o-details">
                            <h4 class="o-title">@b.EquipmentName</h4>
                            <div class="o-meta" style="margin-bottom:6px;">
                                <span style="font-weight:600; color:#475569;"><i class="fas fa-user text-muted"></i> @b.FarmerName</span>
                            </div>
                            <div class="o-meta">
                                <span><i class="far fa-calendar-alt text-muted"></i> @b.StartDate.ToString("dd MMM") → @b.EndDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <div style="font-size:12px; color:#94a3b8; margin-top:8px;">
                                <strong>Request #@b.BookingId</strong>
                            </div>
                        </div>
                        
                        <div class="o-finance">
                            <div style="font-size:12px; color:#64748b; font-weight:600; text-transform:uppercase;">Payout</div>
                            <div class="o-amt">₹@b.TotalPrice.ToString("N0")</div>
                        </div>

                        <div class="o-actions">
                            @if (b.Status == "Pending")
                            {
                                <form asp-controller="Owner" asp-action="AcceptBooking" method="post" style="display:inline-block;">
                                    <input type="hidden" name="id" value="@b.BookingId" />
                                    <button type="submit" class="btn-o btn-o-del"><i class="fas fa-check"></i> Accept</button>
                                </form>
                                <form asp-controller="Owner" asp-action="RejectBooking" method="post" style="display:inline-block;">
                                    <input type="hidden" name="id" value="@b.BookingId" />
                                    <button type="submit" class="btn-o btn-o-rej" title="Reject"><i class="fas fa-times"></i></button>
                                </form>
                            }
                            else
                            {
                                <div class="o-pill">@b.Status</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ══ SECTION: MY COMPLAINTS ══════════════════════════════════ -->
    <div id="sec-my-complaints" class="od-section" style="display:none; margin-top:24px;">
        @if (!Model.MyComplaints.Any())
        {
            <div class="glass-panel text-center py-5">
                <div class="text-muted" style="font-size:48px; opacity:0.3; margin-bottom:16px;"><i class="fas fa-comment-slash"></i></div>
                <h3 style="font-weight:700; color:#0f172a;">No Complaints Filed</h3>
                <p style="color:#64748b;">You haven't filed any complaints against other users.</p>
            </div>
        }
        else
        {
            <div class="o-list">
                @foreach (var c in Model.MyComplaints)
                {
                    <div class="o-row" style="margin-bottom:12px;">
                        <div class="o-details">
                            <h4 class="o-title">Regarding @c.TargetType: @c.TargetName</h4>
                            <div class="o-meta" style="margin-bottom:6px;">
                                <span style="font-weight:600; color:#475569;"><i class="fas fa-info-circle text-muted"></i> @c.Description</span>
                            </div>
                            <div class="o-meta">
                                <span><i class="far fa-clock text-muted"></i> Filed on @c.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        
                        <div class="o-finance">
                            <div style="font-size:12px; color:#64748b; font-weight:600; text-transform:uppercase;">Status</div>
                            <div class="o-amt" style="font-size:16px; color:@(c.Status == "Pending" ? "#f59e0b" : c.Status == "Resolved" ? "#10b981" : "#ef4444");">@c.Status</div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(c.ResolutionNote))
                        {
                            <div class="o-actions" style="max-width:200px; text-align:right;">
                                <div style="font-size:12px; color:#64748b;"><strong>Note:</strong> @c.ResolutionNote</div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- ══ SECTION: INCOMING COMPLAINTS ══════════════════════════════════ -->
    <div id="sec-incoming-complaints" class="od-section" style="display:none; margin-top:24px;">
        @if (!Model.IncomingComplaints.Any())
        {
            <div class="glass-panel text-center py-5">
                <div class="text-muted" style="font-size:48px; opacity:0.3; margin-bottom:16px;"><i class="fas fa-shield-alt"></i></div>
                <h3 style="font-weight:700; color:#0f172a;">All Clear</h3>
                <p style="color:#64748b;">There are no complaints against your listings. Great job!</p>
            </div>
        }
        else
        {
            <div class="o-list">
                @foreach (var c in Model.IncomingComplaints)
                {
                    <div class="o-row" style="margin-bottom:12px; border-left: 4px solid @(c.Status == "Pending" ? "#f59e0b" : "#e2e8f0");">
                        <div class="o-details">
                            <h4 class="o-title">Filed by @c.FiledBy</h4>
                            <div class="o-meta" style="margin-bottom:4px;">
                                <span style="font-weight:600; color:#3b82f6;"><i class="fas fa-box text-muted"></i> @c.TargetType: @c.TargetName</span>
                            </div>
                            <div class="o-meta" style="margin-bottom:6px;">
                                <span style="font-weight:600; color:#475569;"><i class="fas fa-exclamation-circle text-muted"></i> @c.Description</span>
                            </div>
                            <div class="o-meta">
                                <span><i class="far fa-clock text-muted"></i> @c.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        
                        <div class="o-finance">
                            <div style="font-size:12px; color:#64748b; font-weight:600; text-transform:uppercase;">Status</div>
                            <div class="o-amt" style="font-size:16px; color:@(c.Status == "Pending" ? "#f59e0b" : c.Status == "Resolved" ? "#10b981" : "#ef4444");">@c.Status</div>
                        </div>

                        <div class="o-actions">
                            @if (c.Status == "Pending")
                            {
                                <button class="btn-o btn-o-proc" onclick="confirmResolveComplaint(@c.ComplaintId, '@c.FiledBy.Replace("'", "\\'")')"><i class="fas fa-check"></i> Resolve</button>
                            }
                            else if (!string.IsNullOrEmpty(c.ResolutionNote))
                            {
                                <div style="font-size:12px; color:#64748b; max-width:150px;"><strong>Note:</strong> @c.ResolutionNote</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ══ SECTION: MY REVIEWS ══════════════════════════════════ -->
    <div id="sec-my-reviews" class="od-section" style="display:none; margin-top:24px;">
        @if (!Model.MyReviews.Any())
        {
            <div class="glass-panel text-center py-5">
                <div class="text-muted" style="font-size:48px; opacity:0.3; margin-bottom:16px;"><i class="fas fa-star-half-alt"></i></div>
                <h3 style="font-weight:700; color:#0f172a;">No Reviews Written</h3>
                <p style="color:#64748b;">You haven't left any reviews yet.</p>
            </div>
        }
        else
        {
            <div class="o-list">
                @foreach (var r in Model.MyReviews)
                {
                    <div class="o-row" style="margin-bottom:12px;">
                        <div class="o-details">
                            <h4 class="o-title">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <i class="fas fa-star" style="color:@(i < r.RatingValue ? "#f59e0b" : "#e2e8f0"); font-size:14px;"></i>
                                }
                            </h4>
                            <div class="o-meta" style="margin-bottom:6px; margin-top:6px;">
                                <span style="font-weight:600; color:#475569;">"@r.Comment"</span>
                            </div>
                            <div class="o-meta">
                                <span><i class="far fa-clock text-muted"></i> @r.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>

                        <div class="o-actions">
                            <form asp-controller="Owner" asp-action="DeleteReview" method="post" onsubmit="return confirm('Delete this review?');">
                                <input type="hidden" name="id" value="@r.RatingId" />
                                <button type="submit" class="btn-o btn-o-rej" title="Delete"><i class="fas fa-trash-alt"></i></button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ══ SECTION: REVIEW MANAGER ══════════════════════════════════ -->
    <div id="sec-incoming-reviews" class="od-section" style="display:none; margin-top:24px;">
        
        <div class="glass-panel" style="margin-bottom:24px; display:flex; align-items:center; gap:20px;">
            <div style="font-size:48px; color:#f59e0b; font-weight:800; line-height:1;">@Model.AverageRating.ToString("0.0")</div>
            <div>
                <div style="color:#f59e0b; font-size:20px; margin-bottom:4px;">
                    @for (int i = 0; i < 5; i++)
                    {
                        <i class="fas fa-star" style="@(i < Math.Round(Model.AverageRating) ? "" : "color:#e2e8f0;")"></i>
                    }
                </div>
                <div style="font-size:14px; color:#64748b; font-weight:600;">Average Rating (@Model.IncomingReviews.Count reviews)</div>
            </div>
        </div>

        @if (!Model.IncomingReviews.Any())
        {
            <div class="glass-panel text-center py-5">
                <div class="text-muted" style="font-size:48px; opacity:0.3; margin-bottom:16px;"><i class="fas fa-star"></i></div>
                <h3 style="font-weight:700; color:#0f172a;">No Reviews Received</h3>
                <p style="color:#64748b;">You haven't received any reviews on your equipment yet.</p>
            </div>
        }
        else
        {
            <div class="p-grid">
                @foreach (var r in Model.IncomingReviews)
                {
                    <div class="p-card" style="justify-content:space-between;">
                        <div>
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                                <div style="font-weight:700; color:#0f172a;">@r.UserName</div>
                                <div style="color:#f59e0b; font-size:12px;">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <i class="fas fa-star" style="@(i < r.RatingValue ? "" : "color:#e2e8f0;")"></i>
                                    }
                                </div>
                            </div>
                            <p style="font-size:14px; color:#475569; margin:0 0 12px 0; font-style:italic;">"@r.Comment"</p>
                        </div>
                        <div style="font-size:12px; color:#94a3b8;"><i class="far fa-clock"></i> @r.CreatedAt.ToString("dd MMM yyyy")</div>
                    </div>
                }
            </div>
        }
    </div>

</div>

<!-- Delete Confirmation Custom Native Modal -->
<div class="od-modal-overlay" id="deleteModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.6); backdrop-filter:blur(5px); z-index:9999; align-items:center; justify-content:center;">
    <div class="od-modal" style="background:#fff; border-radius:24px; padding:32px; width:90%; max-width:400px; box-shadow:0 20px 40px rgba(0,0,0,0.2); transform:translateY(20px); transition:all 0.3s ease; text-align:center;">
        <div style="width:70px;height:70px;border-radius:20px;background:#fee2e2;color:#ef4444;font-size:30px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px auto;">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 style="font-weight:800; color:#0f172a; font-family:'Outfit',sans-serif; margin-bottom:10px;">Remove Equipment?</h3>
        <p style="color:#64748b; font-size:14px;">This action is permanent and will completely remove this inventory from your fleet.</p>
        <div id="deleteEquipName" style="font-weight:700; color:#1e293b; background:#f8fafc; padding:12px; border-radius:12px; border:1px solid #e2e8f0; margin:20px 0;">—</div>
        
        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="button" onclick="closeDeleteModal()" style="flex:1; padding:12px; border-radius:12px; border:none; background:#f1f5f9; color:#475569; font-weight:700; cursor:pointer;">Cancel</button>
            <button type="button" id="deleteConfirmBtn" onclick="executeDelete()" style="flex:1; padding:12px; border-radius:12px; border:none; background:#ef4444; color:#fff; font-weight:700; cursor:pointer; box-shadow:0 6px 15px rgba(239, 68, 68, 0.3);">Delete Forever</button>
        </div>
    </div>
</div>

<!-- Resolve Complaint Modal -->
<div class="od-modal-overlay" id="resolveModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.6); backdrop-filter:blur(5px); z-index:9999; align-items:center; justify-content:center;">
    <div class="od-modal" style="background:#fff; border-radius:24px; padding:32px; width:90%; max-width:400px; box-shadow:0 20px 40px rgba(0,0,0,0.2); transform:translateY(20px); transition:all 0.3s ease; text-align:center;">
        <div style="width:70px;height:70px;border-radius:20px;background:#dcfce7;color:#16a34a;font-size:30px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px auto;">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3 style="font-weight:800; color:#0f172a; font-family:'Outfit',sans-serif; margin-bottom:10px;">Resolve Complaint</h3>
        <p style="color:#64748b; font-size:14px;">Please provide a note on how this complaint was resolved.</p>
        <div id="resolveComplaintUser" style="font-weight:700; color:#1e293b; background:#f8fafc; padding:12px; border-radius:12px; border:1px solid #e2e8f0; margin:20px 0;">—</div>
        
        <form asp-controller="Owner" asp-action="ResolveComplaint" method="post">
            <input type="hidden" id="resolveComplaintId" name="id" value="" />
            <textarea name="resolutionNote" placeholder="Enter resolution details..." required style="width:100%; padding:12px; border-radius:12px; border:1px solid #e2e8f0; margin-bottom:20px; min-height:80px;"></textarea>
            
            <div style="display:flex; gap:12px;">
                <button type="button" onclick="closeResolveModal()" style="flex:1; padding:12px; border-radius:12px; border:none; background:#f1f5f9; color:#475569; font-weight:700; cursor:pointer;">Cancel</button>
                <button type="submit" style="flex:1; padding:12px; border-radius:12px; border:none; background:#10b981; color:#fff; font-weight:700; cursor:pointer; box-shadow:0 6px 15px rgba(16, 185, 129, 0.3);">Mark Resolved</button>
            </div>
        </form>
    </div>
</div>

<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
<script>
    function updateClock() {
        const now = new Date();
        document.querySelector('#topbarClock span').textContent =
            now.toLocaleDateString('en-IN', { weekday:'short', day:'numeric', month:'short' }) +
            ', ' + now.toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' });
    }
    setInterval(updateClock, 1000);
    updateClock();

    window.switchSection = function(secId, btn) {
        // Change page title appropriately based on section
        const titles = {
            'overview': '<i class="fas fa-layer-group" style="color:#10b981;"></i> Dashboard <span style="font-weight:400;color:#94a3b8;">Overview</span>',
            'equipment': '<i class="fas fa-tractor" style="color:#10b981;"></i> My <span style="font-weight:400;color:#94a3b8;">Equipment</span>',
            'bookings': '<i class="fas fa-calendar-alt" style="color:#10b981;"></i> Booking <span style="font-weight:400;color:#94a3b8;">Requests</span>',
            'my-complaints': '<i class="fas fa-comment-dots" style="color:#10b981;"></i> My <span style="font-weight:400;color:#94a3b8;">Complaints</span>',
            'incoming-complaints': '<i class="fas fa-shield-alt" style="color:#10b981;"></i> Complaint <span style="font-weight:400;color:#94a3b8;">Manager</span>',
            'my-reviews': '<i class="fas fa-star" style="color:#10b981;"></i> My <span style="font-weight:400;color:#94a3b8;">Reviews</span>',
            'incoming-reviews': '<i class="fas fa-star-half-alt" style="color:#10b981;"></i> Review <span style="font-weight:400;color:#94a3b8;">Manager</span>'
        };
        const titleEl = document.querySelector('.page-title');
        if (titleEl && titles[secId]) {
            titleEl.innerHTML = titles[secId];
        }

        // Hide all sections, show active
        document.querySelectorAll('.od-section').forEach(el => el.style.display = 'none');
        document.getElementById('sec-' + secId).style.display = 'block';
        
        // Update nav item active states
        document.querySelectorAll('.od-nav-item').forEach(el => el.classList.remove('active'));
        if (btn) btn.classList.add('active');
    };

    let _deleteId = 0;
    
    window.confirmDelete = function(btn) {
        _deleteId = btn.getAttribute('data-id');
        document.getElementById('deleteEquipName').textContent = btn.getAttribute('data-name');
        const modal = document.getElementById('deleteModal');
        modal.style.display = 'flex';
        setTimeout(() => {
            modal.querySelector('.od-modal').style.transform = 'translateY(0)';
        }, 10);
    };
    
    window.closeDeleteModal = function() {
        const modal = document.getElementById('deleteModal');
        modal.querySelector('.od-modal').style.transform = 'translateY(20px)';
        setTimeout(() => {
            modal.style.display = 'none';
        }, 300);
        _deleteId = 0;
    };
    
    window.executeDelete = function() {
        if (!_deleteId) return;
        const btn = document.getElementById('deleteConfirmBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Deleting…';
        const form = document.getElementById('deleteForm');
        form.action = '/Owner/DeleteEquipment/' + _deleteId;
        form.submit();
    };

    window.confirmResolveComplaint = function(id, userName) {
        document.getElementById('resolveComplaintId').value = id;
        document.getElementById('resolveComplaintUser').textContent = "Complaint by: " + userName;
        const modal = document.getElementById('resolveModal');
        modal.style.display = 'flex';
        setTimeout(() => {
            modal.querySelector('.od-modal').style.transform = 'translateY(0)';
        }, 10);
    };

    window.closeResolveModal = function() {
        const modal = document.getElementById('resolveModal');
        modal.querySelector('.od-modal').style.transform = 'translateY(20px)';
        setTimeout(() => {
            modal.style.display = 'none';
            document.querySelector('#resolveModal form').reset();
        }, 300);
    };
</script>
}
