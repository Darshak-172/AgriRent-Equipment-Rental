@{
    ViewData["Title"] = "Contact Us - AgriRent";
    var currentLanguage = Context.Session.GetString("Language") ?? "en";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <style>
        .contact-hero {
            /* FIX: Removed external Unsplash image to eliminate external dependency (200-500ms delay) */
            background: linear-gradient(135deg, rgba(33, 147, 86, 0.9) 0%, rgba(20, 99, 56, 0.9) 100%);
            padding: 100px 0 60px;
            color: white;
            text-align: center;
            margin-bottom: -50px;
            position: relative;
        }

        .contact-hero::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 50px;
            background: #f8f9fa;
            clip-path: polygon(0 100%, 100% 0, 100% 100%);
        }

        .contact-info-card {
            background: white;
            border-radius: 16px;
            padding: 40px 30px;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
            transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
            height: 100%;
            border: 1px solid rgba(0,0,0,0.02);
        }

        .contact-info-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(40, 167, 69, 0.15);
        }

        .icon-circle {
            width: 70px;
            height: 70px;
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 28px;
            transition: all 0.3s ease;
        }

        .contact-info-card:hover .icon-circle {
            background: #28a745;
            color: white;
            transform: scale(1.1) rotate(10deg);
        }

        .contact-form-wrapper {
            background: white;
            border-radius: 20px;
            padding: 50px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(0, 0, 0, 0.03);
            position: relative;
            z-index: 10;
        }

        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: #28a745;
            font-weight: 600;
        }

        .form-control:focus {
            border-color: #28a745;
            box-shadow: 0 0 0 0.25rem rgba(40, 167, 69, 0.25);
        }

        .btn-modern {
            padding: 12px 30px;
            font-weight: 600;
            border-radius: 50px;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            background: linear-gradient(135deg, #28a745 0%, #208b39 100%);
            border: none;
            color: white;
        }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(40, 167, 69, 0.3);
            background: linear-gradient(135deg, #218838 0%, #1a6d2b 100%);
            color: white;
        }

        .map-container {
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            height: 100%;
            min-height: 400px;
            position: relative;
        }

        .map-placeholder {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: #e9ecef url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%2328a745" fill-opacity="0.1" d="M0,160L48,149.3C96,139,192,117,288,117.3C384,117,480,139,576,149.3C672,160,768,160,864,154.7C960,149,1056,139,1152,144C1248,149,1344,171,1392,181.3L1440,192L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') bottom/cover no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .section-title-modern {
            font-size: 2.5rem;
            font-weight: 800;
            color: #1a1a1a;
            position: relative;
            display: inline-block;
            margin-bottom: 2rem;
        }
        
        .section-title-modern::after {
            content: '';
            position: absolute;
            width: 50%;
            height: 4px;
            background: #28a745;
            bottom: -10px;
            left: 25%;
            border-radius: 2px;
        }
    </style>
}

<!-- Hero Section -->
<section class="contact-hero d-flex flex-column align-items-center justify-content-center">
    <div class="container animate__animated animate__fadeInDown">
        <h1 class="display-3 fw-bold mb-3">Get in Touch</h1>
        <p class="lead fw-light opacity-75 mx-auto" style="max-width: 600px;">
            Have questions about renting equipment, selling produce, or need technical support? Our friendly team is here to help!
        </p>
    </div>
</section>

<!-- Main Contact Section -->
<section class="py-5 bg-light pb-5" style="background-color: #f8f9fa !important;">
    <div class="container position-relative" style="margin-top: -30px; z-index: 5;">
        
        <!-- Contact Information Cards -->
        <div class="row g-4 mb-5 animate__animated animate__fadeInUp">
            <div class="col-md-4">
                <div class="contact-info-card">
                    <div class="icon-circle">
                        <i class="fas fa-map-marked-alt"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Visit Us</h5>
                    <p class="text-muted mb-0">
                        123 Agri Business Park,<br>
                        Ring Road, Sabarmati,<br>
                        Ahmedabad, Gujarat 380005
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="contact-info-card">
                    <div class="icon-circle">
                        <i class="fas fa-phone-volume"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Call Us</h5>
                    <p class="text-muted mb-1">Support: <a href="tel:+919876543210" class="text-decoration-none text-dark fw-medium">+91 98765 43210</a></p>
                    <p class="text-muted mb-0">Sales: <a href="tel:+919123456789" class="text-decoration-none text-dark fw-medium">+91 91234 56789</a></p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="contact-info-card">
                    <div class="icon-circle">
                        <i class="fas fa-envelope-open-text"></i>
                    </div>
                    <h5 class="fw-bold mb-3">Email Us</h5>
                    <p class="text-muted mb-1">General: <a href="mailto:info@agrirent.in" class="text-decoration-none text-dark fw-medium">info@agrirent.in</a></p>
                    <p class="text-muted mb-0">Support: <a href="mailto:support@agrirent.in" class="text-decoration-none text-dark fw-medium">support@agrirent.in</a></p>
                </div>
            </div>
        </div>

        <div class="row g-5 align-items-stretch mt-3">
            <!-- Contact Form -->
            <div class="col-lg-6">
                <div class="contact-form-wrapper animate__animated animate__fadeInLeft">
                    <h3 class="fw-bold mb-4">Send Message <i class="fas fa-paper-plane text-success ms-2 fs-4"></i></h3>
                    <p class="text-muted mb-4">Fill out the form below and we will get back to you within 24 hours.</p>
                    
                    <form id="contactForm" onsubmit="event.preventDefault(); showSuccess();">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="name" placeholder="Your Name" required>
                                    <label for="name">Your Name</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="email" class="form-control" id="email" placeholder="Your Email" required>
                                    <label for="email">Email Address</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="subject" placeholder="Subject" required>
                                    <label for="subject">Subject</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea class="form-control" placeholder="Leave a message here" id="message" style="height: 150px" required></textarea>
                                    <label for="message">Message</label>
                                </div>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-modern w-100">Send Message</button>
                            </div>
                        </div>
                        
                        <!-- Success Message Alert -->
                        <div id="successAlert" class="alert alert-success mt-4 d-none" role="alert">
                            <i class="fas fa-check-circle me-2"></i> Thank you! Your message has been sent successfully. We will reply soon.
                        </div>
                    </form>
                </div>
            </div>

            <!-- Map Area -->
            <div class="col-lg-6">
                <div class="map-container animate__animated animate__fadeInRight">
                    <!-- Placeholder map background, to insert a real maps embed iframe simply replace this inner content -->
                    <div class="map-placeholder">
                        <div class="text-center bg-white p-4 rounded-4 shadow-sm" style="transition: all 0.3s; z-index: 2;">
                            <i class="fas fa-map-pin fs-1 text-success mb-3"></i>
                            <h4 class="fw-bold mb-1">AgriRent HQ</h4>
                            <p class="text-muted mb-0 small">Ahmedabad, Gujarat</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        function showSuccess() {
            const btn = document.querySelector('#contactForm button[type="submit"]');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Sending...';
            btn.disabled = true;
            
            setTimeout(() => {
                document.getElementById('successAlert').classList.remove('d-none');
                document.getElementById('contactForm').reset();
                btn.innerHTML = 'Send Message';
                btn.disabled = false;
                
                // fade out alert after 5 seconds
                setTimeout(() => {
                    document.getElementById('successAlert').classList.add('d-none');
                }, 5000);
            }, 1000);
        }
    </script>
}
