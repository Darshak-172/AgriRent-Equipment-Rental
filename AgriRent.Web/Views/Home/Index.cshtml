@using AgriRent.Web.Services
@model AgriRent.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home Page - AgriRent";
    // Check if user is logged in for button redirection logic
    var userSession = Context.Session.GetString("UserId");
    bool isLoggedIn = !string.IsNullOrEmpty(userSession);
    string equipmentLink = isLoggedIn ? "/Equipment" : "/Account/Login";
    string productsLink = isLoggedIn ? "/Products" : "/Account/Login";
    string loginLink = "/Account/Login";
    
    // Translation helper
    var currentLanguage = Context.Session.GetString("Language") ?? "en";
    string T(string key) => TranslationHelper.Translate(key, currentLanguage);
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/css/home.css" />
}

<!-- 1. Hero Carousel Section -->
<section class="hero-section p-0 border-0">
    <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <!-- Slide 1 -->
            <div class="carousel-item active">
                <div class="hero-slide-bg hero-bg-1"></div>
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center h-100">
                    <h1 class="hero-title animate__animated animate__fadeInDown">@T("HeroTitle1")</h1>
                    <p class="hero-subtitle mb-4 animate__animated animate__fadeInUp">@T("HeroSubtitle1")</p>
                    <div class="animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
                         <a href="@equipmentLink" class="btn btn-success btn-lg px-5 rounded-pill shadow-sm">
                            <i class="fas fa-tractor me-2"></i>@T("RentEquipment")
                        </a>
                    </div>
                </div>
            </div>
            <!-- Slide 2 -->
            <div class="carousel-item">
                <div class="hero-slide-bg hero-bg-2"></div>
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center h-100">
                    <h1 class="hero-title animate__animated animate__fadeInDown">@T("HeroTitle2")</h1>
                    <p class="hero-subtitle mb-4 animate__animated animate__fadeInUp">@T("HeroSubtitle2")</p>
                    <div class="animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
                        <a href="@productsLink" class="btn btn-orange btn-lg px-5 rounded-pill shadow-sm">
                            <i class="fas fa-shopping-basket me-2"></i>@T("BuyProducts")
                        </a>
                    </div>
                </div>
            </div>
            <!-- Slide 3 -->
            <div class="carousel-item">
                <div class="hero-slide-bg hero-bg-3"></div>
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center h-100">
                    <h1 class="hero-title animate__animated animate__fadeInDown">@T("HeroTitle3")</h1>
                    <p class="hero-subtitle mb-4 animate__animated animate__fadeInUp">@T("HeroSubtitle3")</p>
                    <div class="animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
                         <a href="@loginLink" class="btn btn-outline-light btn-lg px-5 rounded-pill shadow-sm">
                            <i class="fas fa-user-plus me-2"></i>@T("JoinNow")
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>

<!-- 2. Search & Quick Filters -->
<section class="container pb-5">
    <div class="search-container mx-auto position-relative">
        <form id="homeSearchForm" onsubmit="return handleSearch(event);">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="searchKeyword" class="form-control form-control-lg border-start-0 ps-0" placeholder="@T("SearchPlaceholder")">
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="searchLocation" class="form-select form-select-lg">
                        <option value="" selected><i class="fas fa-map-marker-alt"></i> @T("Location")</option>
                        @if (Model.Locations != null)
                        {
                            foreach (var loc in Model.Locations)
                            {
                                <option value="@loc">@loc</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="searchCategory" class="form-select form-select-lg">
                        <option value="" selected>@T("Category")</option>
                        @if (Model.Categories != null)
                        {
                            foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </form>
        <!-- Dynamic Search Results Container -->
        <div id="searchResultsContainer" class="search-results-container d-none shadow-lg mt-2 rounded-3 overflow-hidden bg-white" style="position: absolute; z-index: 1000; width: 100%; max-height: 400px; overflow-y: auto;">
        </div>
    </div>
</section>


<!-- 4. Featured Equipment -->
<section id="equipment" class="section-padding">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">@T("FeaturedEquipment")</h2>
            <p class="section-subtitle">@T("TopRatedRentals")</p>
        </div>
        
        <div class="row g-4">
            @if (Model.Equipments != null && Model.Equipments.Any())
            {
                foreach (var item in Model.Equipments)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="equipment-card">
                            <div class="equipment-img-wrapper">
                                <!-- FIX: Add lazy loading to equipment images -->
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-image.svg" : item.ImageUrl)" class="equipment-img" alt="@item.EquipmentName" loading="lazy">
                                <span class="card-badge"><i class="fas fa-star text-warning"></i> 4.5</span>
                            </div>
                            <div class="p-3">
                                <h5 class="fw-bold mb-1">@item.EquipmentName</h5>
                                <p class="text-muted small mb-2"><i class="fas fa-map-marker-alt me-1"></i> @item.Location</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="price-tag">₹@item.Price<span class="text-muted fs-6 fw-normal">/@item.PriceType</span></span>
                                    <a href="@equipmentLink" class="btn btn-sm btn-outline-success rounded-pill">@T("RentNow")</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">@T("NoEquipmentAvailable")</p>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a href="@equipmentLink" class="btn btn-success px-4 rounded-pill">@T("MoreEquipment")</a>
        </div>
    </div>
</section>


<!-- 5. Farm Products Marketplace -->
<section class="section-padding bg-light-green">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <h2 class="section-title">@T("FreshFromFarm")</h2>
                <p class="section-subtitle mb-0">@T("BuyFromLocalFarmers")</p>
            </div>
            <a href="@productsLink" class="btn btn-link text-success fw-bold text-decoration-none">@T("ViewAll") <i class="fas fa-arrow-right ms-1"></i></a>
        </div>

        <div class="row g-4">
            @if (Model.Products != null && Model.Products.Any())
            {
                foreach (var item in Model.Products)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="equipment-card border-0">
                            <div class="equipment-img-wrapper" style="height: 180px;">
                                <!-- FIX: Add lazy loading to product images -->
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-image.svg" : item.ImageUrl)" class="equipment-img" alt="@item.ProductName" loading="lazy">
                            </div>
                            <div class="p-3">
                                <h6 class="text-uppercase text-success small fw-bold">@T("FreshProduce")</h6>
                                <h5 class="fw-bold mb-1">@item.ProductName</h5>
                                <p class="text-muted small mb-2">@T("LocationLabel") @item.Location</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="fw-bold fs-5">₹@item.Price<span class="text-muted fs-6 fw-normal">/@item.Unit</span></span>
                                     <a href="@productsLink" class="btn btn-sm btn-success rounded-circle"><i class="fas fa-plus"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">@T("NoProductsAvailable")</p>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a href="@productsLink" class="btn btn-success px-4 rounded-pill">@T("MoreProducts")</a>
        </div>
    </div>
</section>


<!-- 6. How It Works -->
<section class="section-padding">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">@T("HowItWorks")</h2>
            <p class="section-subtitle">@T("SimpleSteps")</p>
        </div>
        
        <div class="row text-center g-4">
            <div class="col-md-3">
                <div class="step-card">
                    <div class="step-icon"><i class="fas fa-user-plus"></i></div>
                    <div class="step-number">1</div>
                    <h5 class="fw-bold">@T("StepSignUpTitle")</h5>
                    <p class="text-muted small">@T("StepSignUpDesc")</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="step-card">
                    <div class="step-icon"><i class="fas fa-search"></i></div>
                     <div class="step-number">2</div>
                    <h5 class="fw-bold">@T("StepSearchTitle")</h5>
                    <p class="text-muted small">@T("StepSearchDesc")</p>
                </div>
            </div>
            <div class="col-md-3">
                 <div class="step-card">
                    <div class="step-icon"><i class="fas fa-handshake"></i></div>
                     <div class="step-number">3</div>
                    <h5 class="fw-bold">@T("StepRentBuyTitle")</h5>
                    <p class="text-muted small">@T("StepRentBuyDesc")</p>
                </div>
            </div>
            <div class="col-md-3">
                 <div class="step-card">
                    <div class="step-icon"><i class="fas fa-truck"></i></div>
                     <div class="step-number">4</div>
                    <h5 class="fw-bold">@T("StepDeliveryTitle")</h5>
                    <p class="text-muted small">@T("StepDeliveryDesc")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 7. Why Choose AgriRent -->
<section class="section-padding bg-dark text-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <!-- FIX: Replace external Unsplash image with local default, lazy load -->
                <img src="/images/default-image.svg" alt="Why Choose Us" class="img-fluid rounded-4 shadow-lg" loading="lazy">
            </div>
            <div class="col-lg-6 ps-lg-5">
                <h2 class="fw-bold mb-4">@T("WhyChooseUs")</h2>
                <div class="d-flex mb-4">
                    <div class="me-3">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fas fa-rupee-sign"></i>
                        </div>
                    </div>
                    <div>
                        <h5 class="fw-bold">@T("AffordablePricing")</h5>
                        <p class="text-white-50">@T("AffordablePricingDesc")</p>
                    </div>
                </div>
                <div class="d-flex mb-4">
                     <div class="me-3">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                    <div>
                        <h5 class="fw-bold">@T("VerifiedPartners")</h5>
                        <p class="text-white-50">@T("VerifiedPartnersDesc")</p>
                    </div>
                </div>
                <div class="d-flex mb-4">
                     <div class="me-3">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fas fa-headset"></i>
                        </div>
                    </div>
                    <div>
                        <h5 class="fw-bold">@T("Support247")</h5>
                        <p class="text-white-50">@T("Support247Desc")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 8. Testimonials -->
<section class="section-padding">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">@T("WhatFarmersSay")</h2>
            <p class="section-subtitle">@T("RealStories")</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="testimonial-card">
                    <i class="fas fa-quote-left quote-icon"></i>
                    <p class="text-muted mb-4">"@T("Testimonial1")"</p>
                    <div class="d-flex align-items-center justify-content-center">
                        <!-- FIX: Replace external avatar with local default, lazy load -->
                        <img src="/images/default-image.svg" alt="User" class="user-img" loading="lazy">
                        <div class="text-start ms-3">
                            <h6 class="fw-bold mb-0">@T("Testimonial1Name")</h6>
                            <small class="text-muted">@T("Testimonial1Location")</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                 <div class="testimonial-card">
                    <i class="fas fa-quote-left quote-icon"></i>
                    <p class="text-muted mb-4">"@T("Testimonial2")"</p>
                    <div class="d-flex align-items-center justify-content-center">
                        <!-- FIX: Replace external avatar with local default, lazy load -->
                        <img src="/images/default-image.svg" alt="User" class="user-img" loading="lazy">
                        <div class="text-start ms-3">
                            <h6 class="fw-bold mb-0">@T("Testimonial2Name")</h6>
                            <small class="text-muted">@T("Testimonial2Location")</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                 <div class="testimonial-card">
                    <i class="fas fa-quote-left quote-icon"></i>
                    <p class="text-muted mb-4">"@T("Testimonial3")"</p>
                    <div class="d-flex align-items-center justify-content-center">
                        <!-- FIX: Replace external avatar with local default, lazy load -->
                        <img src="/images/default-image.svg" alt="User" class="user-img" loading="lazy">
                        <div class="text-start ms-3">
                            <h6 class="fw-bold mb-0">@T("Testimonial3Name")</h6>
                            <small class="text-muted">@T("Testimonial3Location")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Floating WhatsApp Admin Button -->
<a href="https://wa.me/919016384962" class="whatsapp-float" target="_blank" title="Chat with Admin">
    <i class="fab fa-whatsapp"></i>
</a>

@section Scripts {
    <script>
        // Pass server variables to JS
        window.agriRentHome = {
            isLoggedIn: @(isLoggedIn.ToString().ToLower()),
            loginUrl: '@loginLink'
        };
    </script>
    <script src="~/js/home.js"></script>
}
