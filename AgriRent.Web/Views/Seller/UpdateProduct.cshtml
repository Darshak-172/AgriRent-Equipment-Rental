@{
    Layout = "_SellerLayout";
    ViewData["Title"] = "Update Product – AgriRent";

    var eq = ViewBag.Product as SellerProductItem;
    var categories = ViewBag.Categories as List<object> ?? new List<object>();
    int equipId = ViewBag.ProductId ?? 0;

    string eqName = eq?.ProductName ?? "";
    string eqDesc = eq?.Description ?? "";
    decimal eqPrice = eq?.Price ?? 0;
    string eqUnit = eq?.Unit ?? "";
    int eqStock = eq?.Stock ?? 0;
    string eqLoc = eq?.Location ?? "";
    int? catId = eq?.CategoryId;
    int? subCatId = eq?.SubCategoryId;
}

@section Styles {
    <style>
        .ae-wrap { max-width: 860px; margin: 0 auto; padding-bottom: 60px; }
        .ae-card { background: #fff; border-radius: 24px; box-shadow: 0 4px 24px rgba(0,0,0,.04); overflow: hidden; border: 1px solid rgba(0,0,0,0.05); }

        .ae-card-header {
            background: linear-gradient(135deg, #020617 0%, #0f172a 100%);
            padding: 36px 40px; color: #fff; position: relative; overflow: hidden;
            display: flex; justify-content: space-between; align-items: center;
        }
        .ae-card-header .header-text h2 { font-family: 'Outfit', sans-serif; font-size: 26px; font-weight: 800; margin: 0 0 6px; position: z-index: 1; }
        .ae-bg-shape { position: absolute; width: 150px; height: 150px; background: #f59e0b; filter: blur(40px); opacity: 0.3; border-radius: 50%; right: -20px; top: -50px; }

        .ae-card-body { padding: 40px; }
        .ae-section { font-size: 12px; font-weight: 800; color: #94a3b8; letter-spacing: 1px; text-transform: uppercase; margin: 28px 0 16px; }
        .ae-section:first-child { margin-top: 0; }
        .ae-divider { border: none; border-top: 1px dashed #e2e8f0; margin: 32px 0; }

        .ae-group { margin-bottom: 20px; }
        .ae-label { display: block; font-size: 14px; font-weight: 700; color: #334155; margin-bottom: 8px; }
        .ae-label span { color: #ef4444; margin-left: 2px; }
        .ae-input, .ae-select, .ae-textarea {
            width: 100%; border: 2px solid #e2e8f0; border-radius: 12px;
            padding: 12px 16px; font-size: 15px; font-family: 'Plus Jakarta Sans', sans-serif;
            color: #0f172a; background: #f8fafc; transition: all .2s;
        }
        .ae-input:focus, .ae-select:focus, .ae-textarea:focus {
            outline: none; border-color: #f59e0b; background: #fff; box-shadow: 0 4px 12px rgba(245,158,11,0.1);
        }
        .ae-textarea { resize: vertical; min-height: 120px; }
        .ae-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

        .ae-actions { display: flex; gap: 16px; margin-top: 24px; }
        .ae-submit {
            flex: 1; padding: 16px; background: #f59e0b; color: #fff; border: none; border-radius: 14px;
            font-size: 16px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px;
            transition: all .2s; box-shadow: 0 8px 20px rgba(245,158,11,0.3);
        }
        .ae-submit:hover { transform: translateY(-2px); box-shadow: 0 12px 24px rgba(245,158,11,0.4); background: #d97706; }
        .ae-btn-cancel {
            padding: 16px 24px; background: #f1f5f9; color: #475569; border-radius: 14px;
            font-size: 16px; font-weight: 700; text-decoration: none; transition: 0.2s;
        }
        .ae-btn-cancel:hover { background: #e2e8f0; color: #0f172a; }

        .manage-photos-btn {
            background: rgba(255,255,255,0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2);
            padding: 10px 16px; border-radius: 12px; font-size: 14px; font-weight: 600; text-decoration: none; transition: 0.2s; z-index: 2; position: relative;
        }
        .manage-photos-btn:hover { background: #fff; color: #0f172a; }
    </style>
}

<div class="od-header">
    <h1 class="page-title"><i class="fas fa-pen text-yellow-500"></i> Edit Product</h1>
</div>

<div class="ae-wrap animate-fade-in">
    <div class="ae-card">
        <div class="ae-card-header">
            <div class="ae-bg-shape"></div>
            <div class="header-text">
                <h2>Product Details</h2>
            </div>
            <a href="/Seller/UploadImage?productId=@equipId" class="manage-photos-btn">
                <i class="fas fa-camera"></i> Manage Photos
            </a>
        </div>

        <div class="ae-card-body">
            @if (TempData["Error"] != null)
            {
                <div class="od-alert od-alert-error"><i class="fas fa-exclamation-triangle"></i> @TempData["Error"]</div>
            }

            <form method="post" action="/Seller/UpdateProduct/@equipId" id="updateForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@equipId" />

                <div class="ae-section">1. Basic Info</div>

                <div class="ae-group">
                    <label class="ae-label">Product Name <span>*</span></label>
                    <input type="text" name="productName" value="@eqName" class="ae-input" required maxlength="200" />
                </div>

                <div class="ae-group">
                    <label class="ae-label">Description <span>*</span></label>
                    <textarea name="description" class="ae-textarea" required minlength="10" maxlength="2000">@eqDesc</textarea>
                </div>

                <hr class="ae-divider" />
                <div class="ae-section">2. Categorization & Pricing</div>

                <div class="ae-row">
                    <div class="ae-group">
                        <label class="ae-label">Category <span>*</span></label>
                        <select id="categorySelect" class="ae-select" onchange="loadSubCategories(this)" required>
                            <option value="">— Select Category —</option>
                            @foreach (dynamic cat in categories)
                            {
                                if (cat.id == catId)
                                {
                                    <option value="@cat.id" selected>@cat.name</option>
                                }
                                else
                                {
                                    <option value="@cat.id">@cat.name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="ae-group">
                        <label class="ae-label">Sub-Category <span>*</span></label>
                        <select id="subCatSelect" name="subCategoryId" class="ae-select" required>
                            <option value="">— Select Category First —</option>
                            <!-- Populated via JS -->
                        </select>
                    </div>
                </div>

                <div class="ae-row">
                    <div class="ae-group">
                        <label class="ae-label">Price Rate (₹) <span>*</span></label>
                        <input type="number" name="price" value="@eqPrice.ToString("0.##")" class="ae-input" min="1" max="1000000" step="0.01" required />
                    </div>
                    <div class="ae-group">
                        <label class="ae-label">Unit <span>*</span></label>
                        <input type="text" name="unit" value="@eqUnit" class="ae-input" required />
                    </div>
                </div>
                
                 <div class="ae-row">
                    <div class="ae-group">
                        <label class="ae-label">Available Stock <span>*</span></label>
                        <input type="number" name="stock" value="@eqStock" class="ae-input" min="1" max="10000" required />
                    </div>
                    <div class="ae-group">
                        <label class="ae-label">Location <span>*</span></label>
                        <input type="text" name="location" value="@eqLoc" class="ae-input" required maxlength="200" />
                    </div>
                </div>

                <hr class="ae-divider" />

                <div class="ae-actions">
                    <a href="/Seller/Dashboard" class="ae-btn-cancel">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                    <button type="submit" class="ae-submit" id="saveBtn">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
const catMap = {};
@foreach (dynamic cat in categories)
{
    <text>catMap[@cat.id] = [</text>
    @foreach (dynamic sub in cat.subCategories)
    {
        <text>{ id: @sub.id, name: "@sub.name" },</text>
    }
    <text>];</text>
}

const initialSubId = @(subCatId.HasValue ? subCatId.Value.ToString() : "null");

function loadSubCategories(sel, preselectId = null) {
    const subSel = document.getElementById('subCatSelect');
    subSel.innerHTML = '<option value="">— Select Sub-Category —</option>';
    if(!sel.value) return;

    (catMap[sel.value] || []).forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id; 
        opt.textContent = s.name;
        if (preselectId && preselectId == s.id) opt.selected = true;
        subSel.appendChild(opt);
    });
}

window.onload = () => {
    const cSel = document.getElementById('categorySelect');
    if (cSel.value) {
        loadSubCategories(cSel, initialSubId);
    }
};

document.getElementById('updateForm').addEventListener('submit', function() {
    const btn = document.getElementById('saveBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Saving...';
});
</script>
}
