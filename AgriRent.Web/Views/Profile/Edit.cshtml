@using AgriRent.Web.Services
@{
    ViewData["Title"] = "Edit Profile";
    var currentLanguage = Context.Session.GetString("Language") ?? "en";
    string T(string key) => TranslationHelper.Translate(key, currentLanguage);
}

@section Styles {
    <style>
        .edit-profile-container {
            max-width: 600px;
            margin: 50px auto;
        }
        .profile-edit-card {
            background: white;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }
        .form-control:focus {
            border-color: #2ecc71;
            box-shadow: 0 0 0 0.2rem rgba(46, 204, 113, 0.25);
        }
    </style>
}

<div class="container edit-profile-container pb-5">
    <div class="profile-edit-card">
        <div class="text-center mb-4">
            <div style="width: 80px; height: 80px; background: rgba(46, 204, 113, 0.1); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">
                <i class="fas fa-user-edit" style="font-size: 2rem; color: #2ecc71;"></i>
            </div>
            <h3 class="mt-3">@T("EditProfile")</h3>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Success))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @ViewBag.Success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form method="post" action="/Profile/Edit">
            <div class="mb-3">
                <label for="fullName" class="form-label">@T("FullName")</label>
                <input type="text" class="form-control" id="fullName" name="fullName" value="@ViewBag.DisplayName" required>
            </div>

            <div class="mb-3">
                <label for="username" class="form-label">@T("Username")</label>
                <input type="text" class="form-control" id="username" value="@ViewBag.Username" readonly disabled>
                <small class="text-muted">Username cannot be changed</small>
            </div>

            <div class="mb-3">
                <label for="mobile" class="form-label">@T("MobileNumber")</label>
                <input type="tel" class="form-control" id="mobile" value="@ViewBag.MobileNumber" readonly disabled>
                <small class="text-muted">Mobile number cannot be changed</small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success flex-fill">
                    <i class="fas fa-save me-2"></i>@T("Save")
                </button>
                <a href="/Profile" class="btn btn-outline-secondary flex-fill">
                    <i class="fas fa-times me-2"></i>@T("Cancel")
                </a>
            </div>
        </form>
    </div>
</div>
