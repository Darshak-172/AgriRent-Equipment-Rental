@using AgriRent.Web.Services
@{
    ViewData["Title"] = "Forgot Password";
    var currentLanguage = Context.Session.GetString("Language") ?? "en";
    string T(string key) => TranslationHelper.Translate(key, currentLanguage);
}

<div class="login-page">
    <!-- Step 1: Send OTP -->
    <div class="glass-card" id="step1-card">
        <div class="login-header">
            <picture>
                <source srcset="~/images/agrirent_logo.png" type="image/png">
                <img src="~/images/agrirent_logo.png" class="logo" alt="AgriRent Logo" />
            </picture>
            <h2>@T("ForgotPasswordTitle")</h2>
            <p>@T("EnterMobileOTP")</p>
        </div>

        <form id="sendOtpForm" onsubmit="event.preventDefault(); sendOtp();">
            <div id="step1-error" class="error-message" style="display: none;">
                <i class="fas fa-exclamation-circle"></i>
                <span id="step1-error-text"></span>
            </div>

            <div class="form-group">
                <label class="form-label">@T("MobileNumber")</label>
                <div class="input-container mobile-input-split">
                    <i class="fas fa-phone"></i>
                    <input type="text" value="+91" class="form-input mobile-country-code" readonly />
                    <input type="tel" id="mobileDigits" class="form-input mobile-digits" placeholder="9876543210" 
                           maxlength="10" pattern="\d{10}" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                    <input type="hidden" id="mobileNumber" />
                </div>
                <small class="text-muted" style="font-size: 11px;">@T("EnterMobileHint")</small>
            </div>

            <button type="submit" class="login-btn" id="sendOtpBtn">
                <span>@T("SendOTP")</span>
                <i class="fas fa-paper-plane"></i>
            </button>
        </form>

        <div class="form-footer">
            <p>@T("RememberPassword") <a href="/Account/Login">@T("Login")</a></p>
        </div>
    </div>

    <!-- Step 2: Verify OTP & Reset Password -->
    <div class="glass-card" id="step2-card" style="display: none;">
        <div class="login-header">
            <picture>
                <source srcset="~/images/agrirent_logo.png" type="image/png">
                <img src="~/images/agrirent_logo.png" class="logo" alt="AgriRent Logo" />
            </picture>
            <h2>@T("ResetPassword")</h2>
            <p>@T("EnterOTPNewPassword")</p>
        </div>

        <form id="resetPasswordForm" onsubmit="event.preventDefault(); resetPassword();">
            <div id="step2-error" class="error-message" style="display: none;">
                <i class="fas fa-exclamation-circle"></i>
                <span id="step2-error-text"></span>
            </div>

            <input type="hidden" id="sessionId" />

            <div class="form-group">
                <label class="form-label">@T("OTPCode")</label>
                <div class="input-container">
                    <i class="fas fa-key"></i>
                    <input type="text" id="otpCode" class="form-input" placeholder="123456" 
                           maxlength="6" pattern="\d{6}" required />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">@T("NewPassword")</label>
                <div class="input-container">
                    <i class="fas fa-lock"></i>
                    <input type="password" id="newPassword" class="form-input" placeholder="••••••••" required />
                </div>
            </div>
            
            <div class="form-group">
                <label class="form-label">@T("ConfirmPassword")</label>
                <div class="input-container">
                    <i class="fas fa-lock"></i>
                    <input type="password" id="confirmPassword" class="form-input" placeholder="••••••••" required />
                </div>
            </div>

            <button type="submit" class="login-btn" id="resetBtn">
                <span>@T("ResetPasswordButton")</span>
                <i class="fas fa-check-circle"></i>
            </button>
        </form>

        <div class="form-footer">
            <p><a href="#" onclick="showStep1()">Change Mobile Number</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('body').addClass('auth-body');
        });

        async function sendOtp() {
            const btn = document.getElementById('sendOtpBtn');
            const digits = document.getElementById('mobileDigits').value;
            const mobile = '+91' + digits;
            const errorDiv = document.getElementById('step1-error');
            const errorText = document.getElementById('step1-error-text');

            btn.disabled = true;
            btn.innerHTML = 'Sending... <i class="fas fa-spinner fa-spin"></i>';
            errorDiv.style.display = 'none';

            try {
                const response = await fetch('/api/auth/send-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ MobileNumber: mobile, IsRealOtp: false })
                });

                const data = await response.json();

                if (response.ok) {
                    document.getElementById('sessionId').value = data.sessionId;
                    showStep2();
                } else {
                    throw new Error(data.message || 'Failed to send OTP');
                }
            } catch (err) {
                errorText.innerText = err.message;
                errorDiv.style.display = 'flex';
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>Send OTP</span><i class="fas fa-paper-plane"></i>';
            }
        }

        async function resetPassword() {
            const btn = document.getElementById('resetBtn');
            const digits = document.getElementById('mobileDigits').value;
            const mobile = '+91' + digits;
            const sessionId = document.getElementById('sessionId').value;
            const otp = document.getElementById('otpCode').value;
            const newPass = document.getElementById('newPassword').value;
            const confirmPass = document.getElementById('confirmPassword').value;
            const errorDiv = document.getElementById('step2-error');
            const errorText = document.getElementById('step2-error-text');

            if (newPass !== confirmPass) {
                errorText.innerText = "Passwords do not match";
                errorDiv.style.display = 'flex';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = 'Resetting... <i class="fas fa-spinner fa-spin"></i>';
            errorDiv.style.display = 'none';

            try {
                const response = await fetch('/api/auth/otp-forgot', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        MobileNumber: mobile, 
                        SessionId: sessionId, 
                        Otp: otp,
                        NewPassword: newPass,
                        IsRealOtp: false 
                    })
                });

                let data; 
                try {
                     const text = await response.text();
                     try {
                         data = JSON.parse(text);
                     } catch {
                         data = { message: text };
                     }
                } catch (e) {
                    data = { message: "Unknown error occurred" };
                }

                if (response.ok) {
                    alert('Password reset successful! You can now login.');
                    window.location.href = '/Account/Login';
                } else {
                     let msg = data.message || 'Failed to reset password';
                     throw new Error(msg);
                }
            } catch (err) {
                errorText.innerText = err.message;
                errorDiv.style.display = 'flex';
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>Reset Password</span><i class="fas fa-check-circle"></i>';
            }
        }

        function showStep2() {
            document.getElementById('step1-card').style.display = 'none';
            document.getElementById('step2-card').style.display = 'block';
            document.getElementById('step2-card').style.animation = 'slideUp 0.5s ease';
        }

        function showStep1() {
            document.getElementById('step2-card').style.display = 'none';
            document.getElementById('step1-card').style.display = 'block';
        }
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-login.css" />
    <style>
        /* Override layout padding for full screen feel */
        main { padding-top: 0 !important; }
        .navbar { display: none !important; }
        .footer { display: none !important; }
        
        /* Force background to be hero-4-opt.png specifically for this page */
        body.auth-body {
            background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
            url('/images/hero-4-opt.png') center center / cover no-repeat fixed !important;
        }
    </style>
}
